---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../home/Hero.astro';
import Work from '../home/Work.astro';
import OpenSource from '../home/OpenSource.astro';
import Experience from '../home/Experience.astro';
import About from '../home/About.astro';
import Contact from '../home/Contact.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <Work lang={lang} />
  <OpenSource lang={lang} />
  <Experience lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
