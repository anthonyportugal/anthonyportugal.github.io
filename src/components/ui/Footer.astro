---
import Container from './Container.astro';
import { useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/anthonyportugal',
    label: 'GitHub Profile',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/bruceeanthonyportugalrobles/',
    label: 'LinkedIn Profile',
  },
];

const homeUrl = lang === 'es' ? '/es/' : '/';
---

<footer class="site-footer">
  <Container>
    <div class="grid">
      <div>
        <a href={homeUrl} class="brand">
          Anthony Portugal
        </a>
        <p class="tagline">{t.footer.tagline}</p>
      </div>

      <div class="location">
        <span class="status">
          <span class="pulse" aria-hidden="true">
            <span class="ping"></span>
            <span class="dot"></span>
          </span>
          <span>{t.contact.locLima}</span>
        </span>
      </div>

      <div class="social">
        {socialLinks.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="link"
            aria-label={item.label}
          >
            {item.name}
          </a>
        ))}
      </div>
    </div>

    <div class="legal">
      <p>
        © {currentYear} {t.footer.rights}
      </p>
      <p class="built">
        {t.footer.builtWith}
        <a href="https://astro.build" class="link">
          Astro
        </a>
        {t.footer.and}
        <a href="https://sanctuary-ds.github.io/" class="link sanctuary">
          Sanctuary
        </a>
      </p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: var(--san-space-12);
    border-top: var(--san-border-width-hairline) solid var(--san-lead-soft);
    background: var(--san-surface-sunken);
  }

  .grid {
    display: grid;
    gap: var(--san-space-8);
  }

  .brand {
    color: var(--san-text);
    font: var(--san-type-title-lg);
    text-decoration: none;

    &:hover {
      color: var(--san-accent-ink);
    }
  }

  .tagline {
    margin: var(--san-space-2) 0 0;
    color: var(--san-text-muted);
    font: var(--san-type-body-sm);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--san-space-2);
    padding: var(--san-space-1) var(--san-space-3);
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-radius: var(--san-radius-full);
    background: var(--san-surface-raised-1);
    color: var(--san-text-muted);
    font: var(--san-type-code-sm);
  }

  .pulse {
    position: relative;
    display: flex;
    width: var(--san-space-2);
    height: var(--san-space-2);
  }

  .ping,
  .dot {
    position: absolute;
    inset: 0;
    border-radius: var(--san-radius-full);
    background: var(--san-success);
  }

  .ping {
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .social {
    display: flex;
    gap: var(--san-space-4);
  }

  .link {
    color: var(--san-text-muted);
    font: var(--san-type-code-sm);
    text-decoration: none;
    transition: color var(--san-duration-fast) var(--san-ease-standard);

    &:hover {
      color: var(--san-accent-ink);
    }
  }

  .sanctuary {
    color: var(--san-accent-ink);
  }

  .legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--san-space-4);
    margin-top: var(--san-space-8);
    padding-top: var(--san-space-8);
    border-top: var(--san-border-width-hairline) solid var(--san-lead-soft);
    color: var(--san-text-subtle);
    font: var(--san-type-body-sm);

    & p {
      margin: 0;
    }
  }

  .built {
    display: flex;
    gap: 0.35em;
    font: var(--san-type-code-sm);
  }

  @media (min-width: 640px) {
    .legal {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: center;
    }

    .location {
      display: flex;
      justify-content: center;
    }

    .social {
      justify-content: flex-end;
    }
  }
</style>
