---
interface Props {
  tag?: string;
  title: string;
  highlight?: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { tag, title, highlight, description, align = 'left', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'mb-12 sm:mb-16',
    align === 'center' ? 'mx-auto max-w-2xl text-center' : 'max-w-2xl',
    className,
  ]}
>
  {tag && (
    <div class="mb-3">
      <span class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold uppercase tracking-wider text-ctp-mauve">
        <span class="text-ctp-overlay0">//</span> {tag}
      </span>
    </div>
  )}
  <h2 class="text-3xl font-bold tracking-tight text-ctp-text sm:text-4xl">
    {title}
    {highlight && <span class="text-ctp-mauve"> {highlight}</span>}
  </h2>
  {description && (
    <p class="mt-4 text-base leading-relaxed text-ctp-subtext0 sm:text-lg">{description}</p>
  )}
</div>
