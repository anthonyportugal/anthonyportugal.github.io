---
export interface Props {
  class?: string;
  as?: 'div' | 'section' | 'article' | 'main' | 'header' | 'footer';
}

const { class: className = '', as: Tag = 'div' } = Astro.props;
---

<Tag class:list={['page-width', className]}>
  <slot />
</Tag>

<style>
  .page-width {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: var(--san-space-4);
  }

  @media (min-width: 640px) {
    .page-width {
      padding-inline: var(--san-space-6);
    }
  }

  @media (min-width: 1024px) {
    .page-width {
      padding-inline: var(--san-space-8);
    }
  }
</style>
