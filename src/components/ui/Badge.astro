---
export type BadgeVariant = 'green' | 'mauve' | 'blue' | 'peach' | 'sky' | 'teal' | 'surface';

interface Props {
  variant?: BadgeVariant | undefined;
  pulse?: boolean | undefined;
  class?: string | undefined;
}

const { variant = 'mauve', pulse = false, class: className = '' } = Astro.props;
---

<span class:list={['badge', className]} data-variant={variant}>
  {pulse && (
    <span class="pulse" aria-hidden="true">
      <span class="ping" />
      <span class="dot" />
    </span>
  )}
  <slot />
</span>

<style>
  /* Transitional names kept from the previous palette; each maps to a Sanctuary
     role. A pane is the tinted container a pigment provides; on-pane is its text. */
  .badge {
    --badge-pane: var(--san-accent-pane);
    --badge-text: var(--san-accent-on-pane);
    --badge-dot: var(--san-accent);

    display: inline-flex;
    align-items: center;
    gap: var(--san-space-2);
    padding: var(--san-space-1) var(--san-space-3);
    border: var(--san-border-width-hairline) solid
      color-mix(in oklch, var(--badge-dot) 40%, transparent);
    border-radius: var(--san-radius-full);
    background: var(--badge-pane);
    color: var(--badge-text);
    font: var(--san-type-code-sm);
  }

  [data-variant='green'] {
    --badge-pane: var(--san-success-pane);
    --badge-text: var(--san-success-on-pane);
    --badge-dot: var(--san-success);
  }

  [data-variant='blue'] {
    --badge-pane: var(--san-info-pane);
    --badge-text: var(--san-info-on-pane);
    --badge-dot: var(--san-info);
  }

  [data-variant='peach'] {
    --badge-pane: var(--san-warning-pane);
    --badge-text: var(--san-warning-on-pane);
    --badge-dot: var(--san-warning);
  }

  [data-variant='sky'] {
    --badge-pane: var(--san-glass-azure-pane);
    --badge-text: var(--san-glass-azure-on-pane);
    --badge-dot: var(--san-glass-azure);
  }

  [data-variant='teal'] {
    --badge-pane: var(--san-glass-viridian-pane);
    --badge-text: var(--san-glass-viridian-on-pane);
    --badge-dot: var(--san-glass-viridian);
  }

  [data-variant='surface'] {
    --badge-pane: var(--san-surface-raised-1);
    --badge-text: var(--san-text-muted);
    --badge-dot: var(--san-text-subtle);
  }

  .pulse {
    position: relative;
    display: flex;
    width: var(--san-space-2);
    height: var(--san-space-2);
  }

  .ping,
  .dot {
    position: absolute;
    inset: 0;
    border-radius: var(--san-radius-full);
    background: var(--badge-dot);
  }

  .ping {
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }
</style>
