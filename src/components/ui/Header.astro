---
import Container from './Container.astro';
import { homeUrl as homeUrlFor, languages, useUi, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useUi(lang);

const navItems = [
  { label: t.nav.work, href: '#work' },
  { label: t.nav.openSource, href: '#open-source' },
  { label: t.nav.experience, href: '#experience' },
  { label: t.nav.about, href: '#about' },
];

const homeUrl = homeUrlFor(lang);
---

<header class="site-header">
  <Container>
    <div class="bar">
      <a href={homeUrl} class="brand">
        <span class="monogram" aria-hidden="true">
          AP
        </span>
        <span class="name">Anthony Portugal</span>
      </a>

      <nav class="nav" aria-label={t.nav.label}>
        {navItems.map((item) => (
          <a href={item.href} class="nav-link">
            {item.label}
          </a>
        ))}
      </nav>

      <div class="controls">
        <div class="lang" role="group" aria-label={t.language.label}>
          <a
            href={lang === 'en' ? undefined : '/'}
            data-lang-choice="en"
            tabindex={lang === 'en' ? -1 : 0}
            class="lang-option"
            hreflang="en"
            aria-current={lang === 'en' ? 'page' : undefined}
          >
            EN
            <span class="sr-only" lang="en">
              {' '}
              {languages.en}
            </span>
          </a>
          <a
            href={lang === 'es' ? undefined : '/es/'}
            data-lang-choice="es"
            tabindex={lang === 'es' ? -1 : 0}
            class="lang-option"
            hreflang="es"
            aria-current={lang === 'es' ? 'page' : undefined}
          >
            ES
            <span class="sr-only" lang="es">
              {' '}
              {languages.es}
            </span>
          </a>
        </div>

        <a href="#contact" class="cta">
          <span>{t.nav.contact}</span>
          <svg
            class="arrow"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        </a>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="menu-toggle"
          aria-label={t.nav.toggle}
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg
            id="icon-open"
            class="icon"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="icon-close"
            class="icon"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="mobile-menu" hidden aria-label={t.nav.label}>
      {navItems.map((item) => (
        <a href={item.href} class="mobile-nav-link">
          {item.label}
        </a>
      ))}
      <a href="#contact" class="cta cta-block">
        <span>{t.nav.contact}</span>
        <svg
          class="arrow"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
          />
        </svg>
      </a>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: var(--san-border-width-hairline) solid var(--san-lead-soft);
    background: color-mix(in oklch, var(--san-surface-sunken) 80%, transparent);
    backdrop-filter: blur(var(--san-blur-md));
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--san-space-3);
    color: var(--san-text);
    font: var(--san-type-title-sm);
    text-decoration: none;

    &:hover {
      color: var(--san-accent-ink);
    }

    &:hover .monogram {
      border-color: var(--san-accent);
      box-shadow: var(--san-cast-sm);
    }
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-radius: var(--san-radius-sm);
    background: var(--san-surface-raised-1);
    color: var(--san-accent-ink);
    font: var(--san-type-inscription);
    font-size: 0.75rem;
    transition:
      border-color var(--san-duration-fast) var(--san-ease-standard),
      box-shadow var(--san-duration-fast) var(--san-ease-standard);
  }

  .nav {
    display: none;
    gap: var(--san-space-8);
  }

  .nav-link,
  .mobile-nav-link {
    color: var(--san-text-muted);
    font: var(--san-type-label-lg);
    text-decoration: none;
    transition: color var(--san-duration-fast) var(--san-ease-standard);

    &:hover {
      color: var(--san-text);
    }
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--san-space-3);
  }

  .lang {
    display: inline-flex;
    padding: var(--san-space-half);
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-radius: var(--san-radius-md);
    background: var(--san-surface-sunken);
  }

  .lang-option {
    padding: var(--san-space-1) var(--san-space-2);
    border-radius: var(--san-radius-sm);
    color: var(--san-text-muted);
    font: var(--san-type-code-sm);
    text-decoration: none;
    user-select: none;

    &:hover {
      color: var(--san-text);
    }

    &[aria-current='page'] {
      background: var(--san-glaze-bg);
      color: var(--san-glaze-fg);
      pointer-events: none;
    }
  }

  .cta {
    display: none;
    align-items: center;
    gap: var(--san-space-2);
    padding: var(--san-space-2) var(--san-space-4);
    border: var(--san-border-width-hairline) solid var(--san-glaze-border);
    border-radius: var(--san-radius-md);
    background: var(--san-glaze-sheen), var(--san-glaze-bg);
    color: var(--san-glaze-fg);
    font: var(--san-type-label-md);
    text-decoration: none;
    box-shadow: var(--san-glaze-glow);
    transition: box-shadow var(--san-duration-fast) var(--san-ease-standard);

    &:hover {
      background: var(--san-glaze-sheen), var(--san-glaze-bg-hover);
      box-shadow: var(--san-cast-sm);
      color: var(--san-glaze-fg);
    }

    &:hover .arrow {
      transform: translateX(2px);
    }
  }

  .arrow {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform var(--san-duration-fast) var(--san-ease-standard);
  }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: var(--san-size-control-md);
    height: var(--san-size-control-md);
    border: var(--san-border-width-hairline) solid var(--san-lead);
    border-radius: var(--san-radius-sm);
    background: var(--san-surface-raised-1);
    color: var(--san-text-muted);
    cursor: pointer;

    &:hover {
      color: var(--san-text);
    }
  }

  /* The open/close icon follows the accessible state, not a separate flag. */
  .menu-toggle[aria-expanded='true'] #icon-open,
  .menu-toggle[aria-expanded='false'] #icon-close {
    display: none;
  }

  .icon {
    width: var(--san-size-icon-md);
    height: var(--san-size-icon-md);
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    gap: var(--san-space-1);
    padding: var(--san-space-4) 0 var(--san-space-6);
    border-top: var(--san-border-width-hairline) solid var(--san-lead-soft);

    &[hidden] {
      display: none;
    }
  }

  .mobile-nav-link {
    padding: var(--san-space-2) var(--san-space-3);
    border-radius: var(--san-radius-sm);

    &:hover {
      background: var(--san-state-hover);
    }
  }

  .cta.cta-block {
    display: flex;
    justify-content: center;
    margin-top: var(--san-space-3);
  }

  @media (min-width: 640px) {
    .cta {
      display: inline-flex;
    }
  }

  @media (min-width: 768px) {
    .nav {
      display: flex;
    }

    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  function setupHeader() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('#mobile-menu a');

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isExpanded));
        menu.hidden = isExpanded;
      });

      links.forEach((link) => {
        link.addEventListener('click', () => {
          toggle.setAttribute('aria-expanded', 'false');
          menu.hidden = true;
        });
      });
    }

    // Persist language choice when user manually clicks language switch
    const langLinks = document.querySelectorAll('[data-lang-choice]');
    langLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const isCurrent =
          link.getAttribute('aria-current') === 'page' || !link.hasAttribute('href');
        if (isCurrent) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }

        const choice = link.getAttribute('data-lang-choice');
        if (choice) {
          try {
            localStorage.setItem('preferred-locale', choice);
          } catch {
            // Ignore restricted localStorage
          }
        }
      });
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
