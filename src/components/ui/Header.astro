---
import Container from './Container.astro';
import { useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const navItems = [
  { label: t.nav.services, href: '#services' },
  { label: t.nav.caseStudies, href: '#work' },
  { label: t.nav.openSource, href: '#ecosystem' },
  { label: t.nav.architecture, href: '#philosophy' },
];

const homeUrl = lang === 'es' ? '/es/' : '/';
---

<header class="sticky top-0 z-50 w-full border-b border-ctp-surface0/60 bg-ctp-mantle/80 backdrop-blur-md transition-all duration-200">
  <Container>
    <div class="flex h-16 items-center justify-between">
      <!-- Brand Logo -->
      <a
        href={homeUrl}
        class="group inline-flex items-center gap-2.5 font-mono text-sm font-semibold tracking-tight text-ctp-text transition-colors hover:text-ctp-mauve"
        aria-label="Anthony Portugal - Home"
      >
        <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-ctp-surface1 bg-ctp-surface0/70 font-mono text-xs text-ctp-mauve transition-all group-hover:border-ctp-mauve/60 group-hover:shadow-sm group-hover:shadow-ctp-mauve/20">
          AP
        </span>
        <span class="inline-block text-sm font-semibold tracking-tight text-ctp-text transition-colors group-hover:text-ctp-mauve">
          Anthony Portugal
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden items-center gap-8 md:flex" aria-label="Main Navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-ctp-subtext0 transition-colors hover:text-ctp-text focus-visible:text-ctp-mauve"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Desktop Controls: Language Switcher, CTA & Mobile Toggle -->
      <div class="flex items-center gap-3">
        <!-- Language Switcher Pill -->
        <div
          class="inline-flex items-center rounded-xl border border-ctp-surface1 bg-ctp-surface0/60 p-0.5 font-mono text-xs shadow-inner"
          role="group"
          aria-label="Language selection"
        >
          <a
            href={lang === 'en' ? undefined : '/'}
            data-lang-choice="en"
            tabindex={lang === 'en' ? -1 : 0}
            class:list={[
              'rounded-lg px-2 py-1 font-semibold transition-all select-none',
              lang === 'en'
                ? 'bg-ctp-mauve text-ctp-crust shadow-sm pointer-events-none cursor-default'
                : 'text-ctp-subtext0 hover:text-ctp-text cursor-pointer',
            ]}
            aria-label="Switch to English"
            aria-current={lang === 'en' ? 'page' : undefined}
          >
            EN
          </a>
          <a
            href={lang === 'es' ? undefined : '/es/'}
            data-lang-choice="es"
            tabindex={lang === 'es' ? -1 : 0}
            class:list={[
              'rounded-lg px-2 py-1 font-semibold transition-all select-none',
              lang === 'es'
                ? 'bg-ctp-mauve text-ctp-crust shadow-sm pointer-events-none cursor-default'
                : 'text-ctp-subtext0 hover:text-ctp-text cursor-pointer',
            ]}
            aria-label="Cambiar a Español"
            aria-current={lang === 'es' ? 'page' : undefined}
          >
            ES
          </a>
        </div>

        <a
          href="#contact"
          class="group relative hidden items-center gap-2 rounded-xl bg-gradient-to-r from-ctp-mauve to-ctp-blue px-4 py-2 font-mono text-xs font-semibold text-ctp-crust shadow-md shadow-ctp-mauve/20 transition-all duration-200 hover:shadow-lg hover:shadow-ctp-mauve/30 active:scale-95 sm:inline-flex"
        >
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ctp-crust opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-ctp-crust"></span>
          </span>
          <span>{t.nav.getInTouch}</span>
          <svg
            class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-ctp-surface1 bg-ctp-surface0/60 text-ctp-subtext0 transition-colors hover:text-ctp-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ctp-mauve md:hidden"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg
            id="icon-open"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="icon-close"
            class="hidden h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Navigation -->
    <div
      id="mobile-menu"
      class="hidden border-t border-ctp-surface0/60 pb-6 pt-4 md:hidden"
      aria-label="Mobile Navigation"
    >
      <div class="flex flex-col gap-3">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link rounded-lg px-3 py-2 text-sm font-medium text-ctp-subtext0 transition-colors hover:bg-ctp-surface0 hover:text-ctp-text"
          >
            {item.label}
          </a>
        ))}

        <div class="mt-2 border-t border-ctp-surface0/60 pt-4">
          <a
            href="#contact"
            class="mobile-nav-link flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-ctp-mauve to-ctp-blue px-4 py-2.5 font-mono text-xs font-semibold text-ctp-crust shadow-md shadow-ctp-mauve/20 transition-all"
          >
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ctp-crust opacity-75"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-ctp-crust"></span>
            </span>
            <span>{t.nav.getInTouch}</span>
            <svg
              class="h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </Container>
</header>

<script>
  function setupHeader() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (toggle && menu && iconOpen && iconClose) {
      toggle.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!isExpanded));
        menu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      });

      links.forEach((link) => {
        link.addEventListener('click', () => {
          toggle.setAttribute('aria-expanded', 'false');
          menu.classList.add('hidden');
          iconOpen.classList.remove('hidden');
          iconClose.classList.add('hidden');
        });
      });
    }

    // Persist language choice when user manually clicks language switch
    const langLinks = document.querySelectorAll('[data-lang-choice]');
    langLinks.forEach((link) => {
      link.addEventListener('click', (e) => {
        const isCurrent =
          link.getAttribute('aria-current') === 'page' || !link.hasAttribute('href');
        if (isCurrent) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }

        const choice = link.getAttribute('data-lang-choice');
        if (choice) {
          try {
            localStorage.setItem('preferred-locale', choice);
          } catch {
            // Ignore restricted localStorage
          }
        }
      });
    });
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
