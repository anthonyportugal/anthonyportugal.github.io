---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  class: className = '',
  type = 'button',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : rel}
  type={!href ? type : undefined}
  class:list={['button', className]}
  data-size={size}
  data-variant={variant}
  {...rest}
>
  <slot />
</Tag>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--san-space-2);
    border: var(--san-border-width-hairline) solid transparent;
    border-radius: var(--san-radius-md);
    font: var(--san-type-label-lg);
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    transition:
      background-color var(--san-duration-fast) var(--san-ease-standard),
      border-color var(--san-duration-fast) var(--san-ease-standard),
      color var(--san-duration-fast) var(--san-ease-standard),
      box-shadow var(--san-duration-fast) var(--san-ease-standard),
      transform var(--san-duration-fast) var(--san-ease-standard);

    &:active {
      transform: scale(0.98);
    }

    &:disabled {
      opacity: 0.5;
      pointer-events: none;
    }
  }

  [data-size='sm'] {
    min-height: var(--san-size-control-sm);
    padding-inline: var(--san-space-3);
    font: var(--san-type-label-md);
  }

  [data-size='md'] {
    min-height: var(--san-size-control-md);
    padding-inline: var(--san-space-4);
  }

  [data-size='lg'] {
    min-height: var(--san-size-control-lg);
    padding-inline: var(--san-space-6);
    gap: var(--san-space-3);
  }

  /* Glass: how it is rendered follows the glazing (pot-metal, flashed, grisaille). */
  [data-variant='primary'] {
    background: var(--san-glaze-sheen), var(--san-glaze-bg);
    border-color: var(--san-glaze-border);
    color: var(--san-glaze-fg);
    box-shadow: var(--san-glaze-glow);
    backdrop-filter: var(--san-glaze-blur);

    &:hover {
      background: var(--san-glaze-sheen), var(--san-glaze-bg-hover);
      box-shadow: var(--san-cast-sm);
    }
  }

  /* Stone: raised surface held by lead. */
  [data-variant='secondary'] {
    background: var(--san-surface-raised-1);
    border-color: var(--san-lead);
    color: var(--san-text);

    &:hover {
      background: var(--san-surface-raised-2);
      border-color: var(--san-accent);
    }
  }

  [data-variant='outline'] {
    background: transparent;
    border-color: var(--san-lead);
    color: var(--san-text);

    &:hover {
      background: var(--san-state-hover);
      border-color: var(--san-accent);
    }
  }

  [data-variant='ghost'] {
    background: transparent;
    color: var(--san-text-muted);

    &:hover {
      background: var(--san-state-hover);
      color: var(--san-text);
    }
  }
</style>
