---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  class: className = '',
  type = 'button',
  ...rest
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ctp-mauve focus-visible:ring-offset-2 focus-visible:ring-offset-ctp-base disabled:opacity-50 disabled:pointer-events-none cursor-pointer select-none';

const sizeStyles: Record<string, string> = {
  sm: 'text-xs px-3 py-1.5 rounded-lg gap-1.5',
  md: 'text-sm px-4 py-2.5 rounded-xl gap-2',
  lg: 'text-base px-6 py-3.5 rounded-xl gap-2.5 font-semibold',
};

const variantStyles: Record<string, string> = {
  primary:
    'bg-ctp-mauve text-ctp-crust font-semibold hover:bg-ctp-lavender shadow-md shadow-ctp-mauve/20 active:scale-[0.98]',
  secondary:
    'bg-ctp-surface0/60 hover:bg-ctp-surface1 border border-ctp-surface1 text-ctp-text hover:border-ctp-mauve/50 active:scale-[0.98]',
  outline:
    'bg-transparent hover:bg-ctp-surface0/50 border border-ctp-surface1 text-ctp-text hover:border-ctp-mauve active:scale-[0.98]',
  ghost:
    'bg-transparent hover:bg-ctp-surface0/50 text-ctp-subtext0 hover:text-ctp-text active:scale-[0.98]',
};

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : rel}
  type={!href ? type : undefined}
  class:list={[baseStyles, sizeStyles[size], variantStyles[variant], className]}
  {...rest}
>
  <slot />
</Tag>
