---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { Blocks, Palette, Gauge, Check } from '@lucide/astro';
import { useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const pillarVisuals = [
  { icon: Blocks, accentColor: 'mauve' as const },
  { icon: Palette, accentColor: 'teal' as const },
  { icon: Gauge, accentColor: 'sky' as const },
];

const pillars = t.services.pillars.map((pillar, idx) => {
  const visual = pillarVisuals[idx] ?? pillarVisuals[0]!;
  return {
    ...pillar,
    icon: visual.icon,
    accentColor: visual.accentColor,
  };
});

const colorClasses = {
  mauve: {
    iconBg: 'bg-ctp-mauve/10 text-ctp-mauve border-ctp-mauve/20',
    borderHover: 'hover:border-ctp-mauve/40',
    checkColor: 'text-ctp-mauve',
    badgeText: 'text-ctp-mauve',
    badgeBg: 'bg-ctp-mauve/10 border-ctp-mauve/20',
  },
  teal: {
    iconBg: 'bg-ctp-teal/10 text-ctp-teal border-ctp-teal/20',
    borderHover: 'hover:border-ctp-teal/40',
    checkColor: 'text-ctp-teal',
    badgeText: 'text-ctp-teal',
    badgeBg: 'bg-ctp-teal/10 border-ctp-teal/20',
  },
  sky: {
    iconBg: 'bg-ctp-sky/10 text-ctp-sky border-ctp-sky/20',
    borderHover: 'hover:border-ctp-sky/40',
    checkColor: 'text-ctp-sky',
    badgeText: 'text-ctp-sky',
    badgeBg: 'bg-ctp-sky/10 border-ctp-sky/20',
  },
};
---

<section id="services" class="relative scroll-mt-16 border-t border-ctp-surface0/60 py-16 sm:py-20">
  <Container>
    <SectionHeading
      tag={t.services.tag}
      title={t.services.title}
      highlight={t.services.highlight}
      description={t.services.description}
    />

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      {pillars.map((service) => {
        const colors = colorClasses[service.accentColor];
        const IconComp = service.icon;

        return (
          <div
            class:list={[
              'surface-card group relative flex flex-col justify-between rounded-2xl border border-ctp-surface0 bg-ctp-mantle/70 p-7 transition-all duration-300 sm:p-8',
              colors.borderHover,
            ]}
          >
            <div>
              <!-- Header: Icon & Category Tagline -->
              <div class="flex items-center justify-between">
                <div
                  class:list={[
                    'flex h-12 w-12 items-center justify-center rounded-xl border transition-transform duration-300 group-hover:scale-105',
                    colors.iconBg,
                  ]}
                >
                  <IconComp class="h-6 w-6" />
                </div>
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-ctp-overlay1">
                  {service.tagline}
                </span>
              </div>

              <!-- Title & Description -->
              <h3 class="mt-6 text-xl font-bold tracking-tight text-ctp-text group-hover:text-ctp-mauve sm:text-2xl">
                {service.title}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-ctp-subtext0">{service.description}</p>

              <!-- Core Deliverables List -->
              <div class="mt-6 border-t border-ctp-surface0/60 pt-6">
                <h4 class="font-mono text-xs font-semibold uppercase tracking-wider text-ctp-subtext1">
                  Deliverables &amp; Outcomes
                </h4>
                <ul class="mt-3 space-y-2.5 text-xs text-ctp-subtext0">
                  {service.deliverables.map((item) => (
                    <li class="flex items-start gap-2">
                      <Check class:list={['mt-0.5 h-3.5 w-3.5 shrink-0', colors.checkColor]} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- ROI Metric Badge -->
            <div class="mt-8 border-t border-ctp-surface0/60 pt-6">
              <div
                class:list={[
                  'flex items-center justify-between rounded-xl border p-3.5 font-mono',
                  colors.badgeBg,
                ]}
              >
                <span class="text-xs text-ctp-subtext0">{service.metricLabel}</span>
                <span class:list={['text-lg font-bold sm:text-xl', colors.badgeText]}>
                  {service.metric}
                </span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </Container>
</section>
