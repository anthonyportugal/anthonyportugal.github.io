---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import {
  ArrowUpRight,
  FolderGit2,
  ExternalLink,
  Terminal,
  Layers,
  ShieldCheck,
} from '@lucide/astro';
import { useTranslations, type Lang } from '../../i18n/translations';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const allOpenSource = (await getCollection('openSource')).sort(
  (a, b) => a.data.order - b.data.order
);

const accentClasses = {
  mauve: {
    borderHover: 'hover:border-ctp-mauve/50',
    badgeVariant: 'mauve' as const,
    metricText: 'text-ctp-mauve',
    borderLight: 'border-ctp-mauve/20',
    bgLight: 'bg-ctp-mauve/5',
  },
  teal: {
    borderHover: 'hover:border-ctp-teal/50',
    badgeVariant: 'teal' as const,
    metricText: 'text-ctp-teal',
    borderLight: 'border-ctp-teal/20',
    bgLight: 'bg-ctp-teal/5',
  },
  sky: {
    borderHover: 'hover:border-ctp-sky/50',
    badgeVariant: 'blue' as const,
    metricText: 'text-ctp-sky',
    borderLight: 'border-ctp-sky/20',
    bgLight: 'bg-ctp-sky/5',
  },
  peach: {
    borderHover: 'hover:border-ctp-peach/50',
    badgeVariant: 'peach' as const,
    metricText: 'text-ctp-peach',
    borderLight: 'border-ctp-peach/20',
    bgLight: 'bg-ctp-peach/5',
  },
  green: {
    borderHover: 'hover:border-ctp-green/50',
    badgeVariant: 'green' as const,
    metricText: 'text-ctp-green',
    borderLight: 'border-ctp-green/20',
    bgLight: 'bg-ctp-green/5',
  },
};
---

<section id="work" class="relative scroll-mt-16 border-t border-ctp-surface0/60 py-16 sm:py-20">
  <Container>
    <!-- Section Main Heading -->
    <SectionHeading
      tag={t.caseStudies.tag}
      title={t.caseStudies.title}
      highlight={t.caseStudies.highlight}
      description={t.caseStudies.description}
    />

    <!-- PART 1: Architectural Case Studies -->
    <div class="space-y-12">
      <div class="flex items-center gap-3">
        <Layers class="h-5 w-5 text-ctp-mauve" />
        <h3 class="font-mono text-sm font-semibold uppercase tracking-wider text-ctp-subtext1">
          {t.caseStudies.sectionHeader}
        </h3>
      </div>

      <div class="grid grid-cols-1 gap-8">
        {allProjects.map((project) => {
          const colors = accentClasses[project.data.accentColor];
          const tProj = t.caseStudies.projects[project.id as keyof typeof t.caseStudies.projects];
          const title = tProj?.title ?? project.data.title;
          const category = tProj?.category ?? project.data.category;
          const clientType = tProj?.clientType ?? project.data.clientType;
          const role = tProj?.role ?? project.data.role;
          const summary = tProj?.summary ?? project.data.summary;
          const metrics = tProj?.metrics ?? project.data.metrics;

          return (
            <article
              class:list={[
                'surface-card group relative overflow-hidden rounded-2xl border border-ctp-surface0 bg-ctp-mantle/70 p-6 transition-all duration-300 sm:p-10',
                colors.borderHover,
              ]}
            >
              <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10">
                <!-- Left: Project Narrative & Solution (7 cols) -->
                <div class="flex flex-col justify-between lg:col-span-7">
                  <div>
                    <!-- Metadata Row -->
                    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
                      <Badge variant={colors.badgeVariant}>{category}</Badge>
                      <span class="font-mono text-xs text-ctp-overlay1">·</span>
                      <span class="font-mono text-xs text-ctp-subtext0">{clientType}</span>
                      <span class="font-mono text-xs text-ctp-overlay1">·</span>
                      <span class="font-mono text-xs text-ctp-overlay0">{project.data.period}</span>
                    </div>

                    <!-- Role & Title -->
                    <h4 class="mt-4 text-2xl font-bold tracking-tight text-ctp-text sm:text-3xl">
                      {title}
                    </h4>
                    <p class="mt-1 font-mono text-xs font-medium text-ctp-mauve">
                      {t.caseStudies.roleLabel} {role}
                    </p>

                    <!-- Summary / Problem & Approach -->
                    <p class="mt-4 text-sm leading-relaxed text-ctp-subtext0 sm:text-base">
                      {summary}
                    </p>
                  </div>

                  <!-- Tech Stack Pills -->
                  <div class="mt-6 flex flex-wrap items-center gap-1.5 pt-4">
                    {project.data.tags.map((tag) => (
                      <span class="rounded-md border border-ctp-surface1 bg-ctp-surface0/60 px-2.5 py-1 font-mono text-xs text-ctp-subtext0">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Right: Measurable Impact & Metrics (5 cols) -->
                <div class="flex flex-col justify-center rounded-xl border border-ctp-surface0 bg-ctp-crust/60 p-6 sm:p-8 lg:col-span-5">
                  <div class="flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-ctp-overlay1">
                    <ShieldCheck class="h-4 w-4 text-ctp-green" />
                    <span>{t.caseStudies.roiHeading}</span>
                  </div>

                  <div class="mt-6 grid grid-cols-1 gap-5 divide-y divide-ctp-surface0/80">
                    {metrics.map((metric, idx) => (
                      <div class:list={['flex items-baseline justify-between', idx > 0 && 'pt-4']}>
                        <span class="text-sm font-medium text-ctp-subtext0">{metric.label}</span>
                        <span
                          class:list={[
                            'font-mono text-2xl font-bold tracking-tight sm:text-3xl',
                            colors.metricText,
                          ]}
                        >
                          {metric.value}
                        </span>
                      </div>
                    ))}
                  </div>

                  <div class="mt-6 rounded-lg border border-ctp-surface0/80 bg-ctp-mantle/50 p-3 text-center text-xs text-ctp-overlay1">
                    {t.caseStudies.verifiedPill}
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    <!-- PART 2: Open-Source & Systems Architecture -->
    <div
      id="ecosystem"
      class="mt-16 scroll-mt-16 border-t border-ctp-surface0/60 pt-16 sm:mt-20 sm:pt-20 space-y-10"
    >
      <div class="flex flex-col justify-between gap-4 border-b border-ctp-surface0/60 pb-6 sm:flex-row sm:items-end">
        <div>
          <div class="flex items-center gap-2">
            <Terminal class="h-5 w-5 text-ctp-sky" />
            <h3 class="font-mono text-sm font-semibold uppercase tracking-wider text-ctp-sky">
              {t.openSource.tag}
            </h3>
          </div>
          <h4 class="mt-2 text-2xl font-bold tracking-tight text-ctp-text sm:text-3xl">
            {t.openSource.title}
          </h4>
          <p class="mt-2 max-w-2xl text-sm text-ctp-subtext0 sm:text-base">
            {t.openSource.description}
          </p>
        </div>

        <Button
          href="https://github.com/anthonyportugal"
          target="_blank"
          variant="secondary"
          size="sm"
        >
          <FolderGit2 class="h-4 w-4" />
          {t.openSource.viewAll}
        </Button>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {allOpenSource.map((repo) => {
          const colors = accentClasses[repo.data.accentColor];
          const tRepo = t.openSource.repos[repo.id as keyof typeof t.openSource.repos];
          const title = tRepo?.title ?? repo.data.title;
          const category = tRepo?.category ?? repo.data.category;
          const tagline = tRepo?.tagline ?? repo.data.tagline;
          const description = tRepo?.description ?? repo.data.description;
          const liveUrlLabel =
            tRepo && 'liveUrlLabel' in tRepo && tRepo.liveUrlLabel
              ? tRepo.liveUrlLabel
              : (repo.data.liveUrlLabel ?? t.openSource.liveShowcase);

          return (
            <div
              class:list={[
                'surface-card group flex flex-col justify-between rounded-2xl border border-ctp-surface0 bg-ctp-mantle/70 p-6 transition-all duration-300 sm:p-7',
                colors.borderHover,
              ]}
            >
              <div>
                <!-- Category & Repo Name -->
                <div class="flex items-center justify-between">
                  <Badge variant={colors.badgeVariant}>{category}</Badge>
                  {repo.data.liveUrlLabel ? (
                    <span class="inline-flex items-center gap-1 rounded-full border border-ctp-teal/40 bg-ctp-teal/10 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-ctp-teal">
                      {t.openSource.officialFeature}
                    </span>
                  ) : (
                    <span class="font-mono text-xs text-ctp-overlay1">
                      {t.openSource.archLinux}
                    </span>
                  )}
                </div>

                <h5 class="mt-4 font-mono text-xl font-bold tracking-tight text-ctp-text group-hover:text-ctp-mauve sm:text-2xl">
                  {title}
                </h5>

                <p class="mt-2 text-xs font-medium text-ctp-subtext1">{tagline}</p>

                <p class="mt-3 text-xs leading-relaxed text-ctp-subtext0 sm:text-sm">
                  {description}
                </p>

                <!-- Tech pills -->
                <div class="mt-5 flex flex-wrap gap-1.5">
                  {repo.data.technologies.map((tech) => (
                    <span class="rounded border border-ctp-surface1 bg-ctp-surface0/50 px-2 py-0.5 font-mono text-[11px] text-ctp-subtext1">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action Links -->
              <div class="mt-6 flex flex-wrap items-center gap-3 border-t border-ctp-surface0/60 pt-5">
                <a
                  href={repo.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-ctp-text transition-colors hover:text-ctp-mauve"
                >
                  <FolderGit2 class="h-4 w-4 text-ctp-mauve" />
                  <span>{t.openSource.sourceCode}</span>
                  <ArrowUpRight class="h-3 w-3 text-ctp-overlay1" />
                </a>

                {repo.data.liveUrl && (
                  <a
                    href={repo.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-md border border-ctp-teal/30 bg-ctp-teal/10 px-3 py-1 font-mono text-xs font-semibold text-ctp-teal transition-colors hover:bg-ctp-teal/20"
                  >
                    <ExternalLink class="h-3.5 w-3.5" />
                    <span>{liveUrlLabel}</span>
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </Container>
</section>
