---
import '@sanctuary-ds/tokens/css';
import '../styles/global.css';
import { Font } from 'astro:assets';
import { fontBridge, fontRoles } from '../data/fonts';

import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import { links, useUi, type Lang } from '../i18n/ui';
import palette from '@sanctuary-ds/tokens/palette' with { type: 'json' };

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const meta = useUi(lang).meta;
// The size and description below belong to the default card; a page that passes
// its own image publishes only the image, never another picture's metadata.
const DEFAULT_IMAGE = '/og-image.png';
const { title = meta.title, description = meta.description, image = DEFAULT_IMAGE } = Astro.props;
const isDefaultImage = image === DEFAULT_IMAGE;

// The browser chrome follows the stone of the flavor the visitor will see.
const themeColor = {
  dark: palette.flavors.compline.colors.surface.hex,
  light: palette.flavors.lauds.colors.surface.hex,
};

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang} data-san-flavor="compline" data-san-accent="cobalt">
  <head>
    <!-- Lauds is the only light flavor: follow the visitor's system preference
         before the first paint, so the page never flashes in the wrong light.
         Nothing is stored; the rose window in Work can relight the page for the visit. -->
    <script is:inline>
      (function () {
        const light = window.matchMedia('(prefers-color-scheme: light)');
        const root = document.documentElement;
        const apply = () => (root.dataset.sanFlavor = light.matches ? 'lauds' : 'compline');
        apply();
        // RoseWindow.astro sets data-relit once the visitor relights the page;
        // from then on their choice wins over later system changes.
        light.addEventListener('change', () => {
          if (!root.hasAttribute('data-relit')) apply();
        });
      })();
    </script>
    <!-- Language Auto-Detection & Immediate Routing (Zero-FOUC) -->
    <script is:inline>
      (function () {
        try {
          const savedLang = localStorage.getItem('preferred-locale');
          const path = window.location.pathname;
          const isEsPath = path.startsWith('/es') || path === '/es';

          if (!savedLang) {
            const browserLang = (navigator.language || '').toLowerCase();
            if (browserLang.startsWith('es') && !isEsPath) {
              window.location.replace('/es' + window.location.search + window.location.hash);
            }
          } else if (savedLang === 'es' && !isEsPath) {
            window.location.replace('/es' + window.location.search + window.location.hash);
          } else if (savedLang === 'en' && isEsPath) {
            window.location.replace('/' + window.location.search + window.location.hash);
          }
        } catch {
          // Ignore localStorage access restrictions in strict environments
        }
      })();
    </script>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {fontRoles.map(({ cssVariable, preload }) => (
      <Font cssVariable={cssVariable} preload={preload} />
    ))}
    <style is:inline set:html={fontBridge}></style>
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Multilingual SEO Alternates (hreflang) -->
    <link rel="alternate" hreflang="en" href="https://anthonyportugal.github.io/" />
    <link rel="alternate" hreflang="es" href="https://anthonyportugal.github.io/es/" />
    <link rel="alternate" hreflang="x-default" href="https://anthonyportugal.github.io/" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Anthony Portugal (Anthony Portugal Robles)" />
    <meta
      name="keywords"
      content="Anthony Portugal, Anthony Portugal Robles, Brucee Anthony Portugal Robles, Software Engineer, Frontend Architect, Design Systems, Design Tokens, Sanctuary, Peru"
    />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColor.dark} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColor.light} />
    <meta name="google-site-verification" content="7d7NMlLI0KPl4VqcY3-CAB96dk47fPgB0K2zgnF0d2Y" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    {isDefaultImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={meta.imageAlt} />
      </>
    )}
    <meta property="og:locale" content={lang === 'es' ? 'es_PE' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    {isDefaultImage && <meta name="twitter:image:alt" content={meta.imageAlt} />}

    <!-- Structured Data (JSON-LD) for Search Engines -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Anthony Portugal',
        alternateName: ['Anthony Portugal Robles', 'Brucee Anthony Portugal Robles'],
        givenName: 'Anthony',
        familyName: 'Portugal Robles',
        url: 'https://anthonyportugal.github.io',
        sameAs: [links.github, links.linkedin],
        jobTitle: meta.jobTitle,
        address: {
          '@type': 'PostalAddress',
          addressCountry: 'PE',
        },
        knowsAbout: [
          'Design Systems',
          'Design Tokens',
          'Frontend Architecture',
          'Clean Architecture',
          'TypeScript',
          'Vue',
          'Flutter',
          'Linux',
          'AI-assisted software engineering',
        ],
      })}
    ></script>
  </head>
  <body>
    <!-- Light cast from above through the accent glass -->
    <div class="ambient" aria-hidden="true"></div>

    <!-- Header Navigation -->
    <Header lang={lang} />

    <!-- Main page content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <Footer lang={lang} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    position: relative;
    z-index: 1;
    flex: 1;
  }

  .ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 80% 60% at 50% -20%,
      color-mix(in oklch, var(--san-accent) 14%, transparent),
      transparent
    );
  }
</style>
