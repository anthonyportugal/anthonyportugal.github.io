---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/main.scss';

import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import type { Lang } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: Lang;
}

const {
  lang = 'en',
  title = lang === 'es'
    ? 'Anthony Portugal | Ingeniero de Software y Arquitecto'
    : 'Anthony Portugal | Senior Software Engineer & Architect',
  description = lang === 'es'
    ? 'Ingeniero de Software Senior y Arquitecto construyendo plataformas escalables, aplicaciones multiplataforma y herramientas de sistema para Linux.'
    : 'Senior Software Engineer & Architect building scalable platforms, multiplatform applications, and Linux systems tooling.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <!-- Language Auto-Detection & Immediate Routing (Zero-FOUC) -->
    <script is:inline>
      (function () {
        try {
          const savedLang = localStorage.getItem('preferred-locale');
          const path = window.location.pathname;
          const isEsPath = path.startsWith('/es') || path === '/es';

          if (!savedLang) {
            const browserLang = (navigator.language || '').toLowerCase();
            if (browserLang.startsWith('es') && !isEsPath) {
              window.location.replace('/es' + window.location.search + window.location.hash);
            }
          } else if (savedLang === 'es' && !isEsPath) {
            window.location.replace('/es' + window.location.search + window.location.hash);
          } else if (savedLang === 'en' && isEsPath) {
            window.location.replace('/' + window.location.search + window.location.hash);
          }
        } catch {
          // Ignore localStorage access restrictions in strict environments
        }
      })();
    </script>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Multilingual SEO Alternates (hreflang) -->
    <link rel="alternate" hreflang="en" href="https://anthonyportugal.github.io/" />
    <link rel="alternate" hreflang="es" href="https://anthonyportugal.github.io/es/" />
    <link rel="alternate" hreflang="x-default" href="https://anthonyportugal.github.io/" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Anthony Portugal" />
    <meta name="theme-color" content="#1e1e2e" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
  </head>
  <body class="relative flex min-h-screen flex-col bg-ctp-base text-ctp-text selection:bg-ctp-mauve/30 selection:text-ctp-text">
    <!-- Ambient subtle background glow -->
    <div
      class="pointer-events-none fixed inset-0 z-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(203,166,247,0.12),rgba(255,255,255,0))]"
      aria-hidden="true"
    ></div>

    <!-- Header Navigation -->
    <Header lang={lang} />

    <!-- Main page content -->
    <main class="relative z-10 flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <Footer lang={lang} />
  </body>
</html>
